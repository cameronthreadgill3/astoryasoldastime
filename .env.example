# Admin gate for /admin (httpOnly cookie session)
ADMIN_PASSWORD=changeme

# Public site URL (used for Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Vercel Blob for uploads + JSON store on serverless
# BLOB_READ_WRITE_TOKEN=

# Optional: Stripe Checkout (omit all three to use Demo checkout)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
